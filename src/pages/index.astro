---
import { allPages } from '../lib/routes';
import { DEFAULT_LOCALE } from '../i18n/config';
import Home from '../views/Home.astro';

// Site root renders the default-language home (canonical points to /<default>/), so the
// theme switcher and language links are available from the very first page.
const page = allPages().find((p) => p.locale === DEFAULT_LOCALE && p.id === 'home')!;
---
<Home locale={DEFAULT_LOCALE} page={page} />
