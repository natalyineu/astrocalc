---
import { getT, enabledLocales, localeMeta } from '../i18n';
import { alternates, pageUrl } from '../lib/routes';
import { TOOL_IDS, SIGN_IDS, SIGN_CORE, STATIC_PAGE_IDS } from '../data/core';
import { DEFAULT_LOCALE } from '../i18n/config';
import Icon from '../components/Icon.astro';
import '@fontsource-variable/plus-jakarta-sans';
import '@fontsource-variable/space-grotesk';

interface Props { locale: string; pageId: string; title: string; description: string }
const { locale, pageId, title, description } = Astro.props;
const t = getT(locale);
const meta = localeMeta(locale);
const site = Astro.site!;
const abs = (p: string) => new URL(p, site).toString();
const alts = alternates(pageId);
const self = alts.find((a) => a.locale === locale)!;
const xDefault = alts.find((a) => a.locale === DEFAULT_LOCALE) ?? alts[0];
const adsenseClient = import.meta.env.PUBLIC_ADSENSE_CLIENT;
const analyticsId = import.meta.env.PUBLIC_GA_ID;
const defaultTheme = import.meta.env.PUBLIC_THEME || 'astromatch';
const showSwitcher = false;
const themes = [
  ['genz', 'Gen Z'], ['millennial', 'Millennial'], ['genx', 'Gen X'], ['boomer', 'Boomer'], ['cosmic', 'Cosmic'], ['astromatch', 'AstroMatch'],
];
---
<!doctype html>
<html lang={meta.tag} dir={meta.dir ?? 'ltr'} data-theme={defaultTheme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={abs(self.path)} />
    {alts.map((a) => <link rel="alternate" hreflang={a.tag} href={abs(a.path)} />)}
    <link rel="alternate" hreflang="x-default" href={abs(xDefault.path)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={abs(self.path)} />
    <meta property="og:site_name" content={t.site.name} />
    <meta property="og:locale" content={meta.tag.replace('-', '_')} />
    <meta name="theme-color" content="#4c3a8c" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    {adsenseClient && (
      <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseClient}`} crossorigin="anonymous"></script>
    )}
    {analyticsId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${analyticsId}`}></script>
        <script is:inline define:vars={{ analyticsId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', analyticsId);
        </script>
      </>
    )}
  </head>
  <body>
    <header class="site-header">
      <div class="wrap bar">
        <a class="logo" href={pageUrl(locale, 'home')}>
          <img class="logo-mark" src={`${import.meta.env.BASE_URL}logo-mark.svg`} alt="" width="40" height="24" />
          <span class="logo-text"><span class="logo-name">{t.site.name}</span><span class="logo-sub">{t.match.brandSub}</span></span>
        </a>
        <nav>
          {TOOL_IDS.map((id) => <a href={pageUrl(locale, `tool:${id}`)}>{t.nav[id]}</a>)}
        </nav>
        <div class="lang-pills" role="group" aria-label={t.ui.language}>
          <span class="lang-globe"><Icon name="globe" size={14} /></span>
          {alts.map((a) => <a href={a.path} hreflang={a.tag} lang={a.tag} title={a.native} aria-current={a.locale === locale ? 'true' : undefined}>{a.locale.toUpperCase()}</a>)}
        </div>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p class="signs-row">
          {SIGN_IDS.map((id) => <a href={pageUrl(locale, `sign:${id}`)} title={t.signs[id].name}>{SIGN_CORE[id].symbol}</a>)}
        </p>
        <p>
          {STATIC_PAGE_IDS.map((p, i) => <><a href={pageUrl(locale, `page:${p}`)}>{t.pages[p].h1}</a>{i < STATIC_PAGE_IDS.length - 1 ? ' · ' : ''}</>)}
        </p>
        <p class="langs">
          {alts.map((a) => <a href={a.path} hreflang={a.tag}>{a.native}</a>)}
        </p>
        <p class="muted">{t.ui.disclaimer}</p>
        <p class="foot-mono">© {new Date().getFullYear()} {t.site.name} • {t.match.badge}</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  /* ---- Design tokens ---- */
  :root, [data-theme="astromatch"] {
    --page-bg:
      radial-gradient(rgba(255,255,255,.08) 1px, transparent 1px),
      radial-gradient(40rem 40rem at -5% -8%, #9333ea26 0%, transparent 70%),
      radial-gradient(42rem 42rem at 105% 35%, #c026d326 0%, transparent 70%),
      radial-gradient(40rem 40rem at 25% 108%, #4f46e526 0%, transparent 70%), #05040a;
    --page-bg-size: 28px 28px, auto, auto, auto, auto;
    --card: #121021b8; --card-border: #ffffff14;
    --ink: #f1f5f9; --muted: #94a3b8; --link: #d8b4fe;
    --brand: #c084fc; --brand-dark: #e9d5ff; --accent: #f0abfc; --line: #ffffff14;
    --header-bg: #121021b8; --header-ink: #f5d0fe; --header-border: 1px solid #ffffff1a;
    --btn-bg: linear-gradient(90deg, #9333ea, #c026d3, #4f46e5); --btn-ink: #fff; --btn-radius: 16px; --btn-border: 0;
    --btn-shadow: 0 10px 30px -8px #c026d359;
    --radius: 18px; --shadow: 0 10px 30px -12px #a855f733;
    --font: "Plus Jakarta Sans Variable", "Plus Jakarta Sans", "Avenir Next", "Segoe UI", Roboto, "Noto Sans", system-ui, sans-serif;
    --heading-font: "Space Grotesk Variable", "Space Grotesk", "Plus Jakarta Sans Variable", "Avenir Next", "Segoe UI", system-ui, sans-serif;
    --heading-weight: 800; --heading-style: normal; --heading-transform: none; --heading-spacing: -0.02em;
    --fs: 16px; --lh: 1.65; --input-bg: #00000066; --input-ink: #f1f5f9;
    --meter-fill: linear-gradient(90deg, #ec4899, #c026d3, #6366f1); --meter-bg: #ffffff1a;
    --big: #e9d5ff; --tile-bg: #ffffff0d;
  }

  * { box-sizing: border-box; }
  html { font-size: var(--fs); }
  body {
    margin: 0; font-family: var(--font); line-height: var(--lh); color: var(--ink);
    background: var(--page-bg); background-size: var(--page-bg-size); background-attachment: fixed;
    min-height: 100vh;
    overflow-x: hidden;
  }
  .wrap { max-width: 860px; margin: 0 auto; padding: 0 16px; width: 100%; box-sizing: border-box; }
  
  /* Шапка */
  .site-header { position: sticky; top: 0; z-index: 40; background: var(--header-bg); color: var(--header-ink); border-bottom: var(--header-border); backdrop-filter: blur(16px); width: 100%; }
  .site-header .bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 14px; padding-block: 10px 8px; }
  .site-header a { color: var(--header-ink); text-decoration: none; }
  .logo { display: flex; align-items: center; gap: 10px; font-family: var(--heading-font); font-weight: 700; font-size: 1.25rem; line-height: 1.1; }
  .logo-mark { width: 40px; height: 24px; flex: none; }
  .logo-text { display: grid; }
  .logo-name { font-weight: 800; letter-spacing: -0.01em; background: linear-gradient(90deg, #fff, #e9d5ff, #f0abfc); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
  .logo-sub { font-family: ui-monospace, Menlo, Consolas, monospace; font-size: .55rem; font-weight: 400; letter-spacing: .18em; text-transform: uppercase; color: var(--muted); opacity: .85; }
  
  .site-header nav { order: 3; flex-basis: 100%; display: flex; flex-wrap: wrap; justify-content: center; gap: 4px 14px; font-size: .85rem; padding-bottom: 2px; }
  .site-header nav a { opacity: .9; }
  .site-header nav a:hover { opacity: 1; text-decoration: underline; }

  .lang-pills {
    display: inline-flex !important;
    align-items: center;
    gap: 3px !important;
    padding: 3px 6px !important;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--line);
  }

  .lang-pills a {
    padding: 3px 6px !important;
    border-radius: 999px;
    font-size: 0.68rem !important;
    font-weight: 700;
    text-decoration: none;
    color: var(--muted);
    line-height: 1;
  }

  .lang-pills a[aria-current="true"] {
    background: #c026d3 !important;
    color: #fff !important;
  }

  @media (max-width: 640px) {
    .site-header .bar { padding: 8px 12px; gap: 8px; }
    .logo { font-size: 1.15rem !important; }
    .logo-sub { display: none !important; }
    .site-header nav {
      order: 3;
      width: 100% !important;
      display: flex !important;
      flex-wrap: nowrap !important;
      overflow-x: auto !important;
      justify-content: flex-start !important;
      gap: 6px !important;
      padding: 4px 0 !important;
      margin: 0 !important;
      box-sizing: border-box !important;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .site-header nav::-webkit-scrollbar { display: none; }
    .site-header nav a {
      font-size: 0.74rem !important;
      padding: 5px 10px !important;
      border-radius: 999px !important;
      background: rgba(255, 255, 255, 0.05) !important;
      border: 1px solid rgba(255, 255, 255, 0.08) !important;
      white-space: nowrap !important;
      flex-shrink: 0 !important;
      text-decoration: none !important;
    }
  }

  /* Типографика и карточки калькуляторов */
  h1, h2, h3 { font-family: var(--heading-font); font-weight: var(--heading-weight); }
  h1 { font-size: 2.1rem; line-height: 1.15; margin: 1.5rem 0 .5rem; }
  h2 { font-size: 1.45rem; margin: 2rem 0 .5rem; }
  h3 { font-size: 1.1rem; margin: 1.2rem 0 .3rem; }
  a { color: var(--link); }
  
  /* Сетка калькуляторов и списков (чтобы текст не слипался) */
  .grid { 
    display: grid; 
    gap: 12px; 
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); 
    margin: 16px 0;
  }
  .tile { 
    display: block; 
    text-decoration: none; 
    color: inherit; 
    background: var(--tile-bg); 
    border: 1px solid var(--card-border); 
    border-radius: var(--radius); 
    padding: 16px; 
    transition: transform .12s, border-color .12s; 
  }
  .tile:hover { transform: translateY(-2px); border-color: rgba(255,255,255,0.25); }
  .tile strong { display: block; font-size: 1rem; margin-bottom: 4px; color: #fff; }
  .tile span { color: var(--muted); font-size: 0.85rem; line-height: 1.4; display: block; }

  /* Карточки и инпуты */
  .card { background: var(--card); border: 1px solid var(--card-border); border-radius: var(--radius); padding: 20px; margin: 20px 0; box-shadow: var(--shadow); backdrop-filter: blur(10px); }
  select, input { font: inherit; padding: 10px 12px; border: 1px solid var(--line); border-radius: calc(var(--radius) / 2); background: var(--input-bg); color: var(--input-ink); width: 100%; box-sizing: border-box; }
  button, .btn { font: inherit; font-weight: 700; background: var(--btn-bg); color: var(--btn-ink); border: var(--btn-border); border-radius: var(--btn-radius); box-shadow: var(--btn-shadow); padding: 12px 22px; cursor: pointer; text-decoration: none; display: inline-block; text-align: center; }

  /* Футер со знаками зодиака */
  .site-footer { margin-top: 48px; padding: 24px 0 60px; border-top: 1px solid var(--line); text-align: center; font-size: .95rem; width: 100%; }
  .signs-row { 
    display: flex; 
    flex-wrap: wrap; 
    justify-content: center; 
    gap: 8px 12px; 
    margin: 16px 0;
    padding: 0;
  }
  .signs-row a { text-decoration: none; font-size: 1.35rem; display: inline-block; }
  .langs { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin: 12px 0; }
  .langs a { font-size: .85rem; white-space: nowrap; text-decoration: none; }
  .foot-mono { font-family: ui-monospace, Menlo, Consolas, monospace; font-size: .72rem; color: var(--muted); opacity: .8; }
  .muted { color: var(--muted); font-size: .85rem; }
</style>