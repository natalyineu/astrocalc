---
// Two-date synastry calculator (design reference: docs/reference/astromatch-reference.html).
// All strings come from the locale files (`match`, `compat`, `signs`, `elements`).
import Icon from './Icon.astro';
import { getT, allSigns } from '../lib/content';
import { pageUrl } from '../lib/routes';
import { SIGN_IDS, SIGN_CORE } from '../data/core';
import { enabledLocales } from '../i18n';

const { locale, title } = Astro.props as { locale: string; title?: string };
const t = getT(locale);
const m = t.match;
const kofi = import.meta.env.PUBLIC_KOFI_URL || 'https://ko-fi.com';
const telegram = import.meta.env.PUBLIC_TELEGRAM_URL || 'https://t.me';
const signs = allSigns(locale);

const pairUrls: Record<string, string> = {};
for (const a of SIGN_IDS) for (const b of SIGN_IDS) {
  const [x, y] = SIGN_IDS.indexOf(a) > SIGN_IDS.indexOf(b) ? [b, a] : [a, b];
  pairUrls[`${a}|${b}`] = pageUrl(locale, `pair:${x}:${y}`);
}
const data = {
  ui: m,
  site: t.site.name,
  pairUrls,
  signs: Object.fromEntries(signs.map((s) => [s.id, {
    name: s.name, symbol: s.symbol, element: SIGN_CORE[s.id].element, modality: SIGN_CORE[s.id].modality,
    elementName: s.element, challenges: s.challenges, strengths: s.strengths,
  }])),
  ratings: t.compat.ratings,
  elementPairs: t.compat.elementPairs,
  modalityPairs: t.compat.modalityPairs,
  challengesLine: t.compat.challengesLine,
  elementLabel: m.elementLabel,
  ranges: Object.fromEntries(SIGN_IDS.map((id) => [id, [SIGN_CORE[id].start, SIGN_CORE[id].end]])),
};
const stats = [
  { v: '78', l: m.stat1, c: 'c1' },
  { v: String(enabledLocales().length), l: m.stat2, c: 'c2' },
  { v: m.stat3Value, l: m.stat3, c: 'c3' },
];
const dims = [
  { k: 'love', label: m.dimLove, icon: 'heart', fill: true, cls: 'love' },
  { k: 'passion', label: m.dimPassion, icon: 'flame', fill: true, cls: 'passion' },
  { k: 'trust', label: m.dimTrust, icon: 'shield-check', fill: false, cls: 'trust' },
  { k: 'mind', label: m.dimMind, icon: 'message-circle', fill: false, cls: 'mind' },
];
const first = signs[0];
const sixth = signs[5];
---
<section class="m-app" id="match-app" aria-labelledby="m-title">
  <div class="m-hero">
    <span class="m-pill"><Icon name="heart" size={14} fill />{m.badge}</span>
    <h1 id="m-title">{title ?? m.title}</h1>
    <p>{m.subtitle}</p>
  </div>

  <div id="m-input" class="m-stack">
    <div class="m-cards">
      <span class="m-join" aria-hidden="true"><Icon name="sparkles" size={16} /></span>
      {[1, 2].map((n) => (
        <div class={`m-card m-p${n}`}>
          <div class="m-tag"><Icon name="user" size={14} />{n === 1 ? m.partner1 : m.partner2}</div>
          <label>{m.nameLabel}
            <input type="text" id={`n${n}`} placeholder={n === 1 ? m.namePlaceholder1 : m.namePlaceholder2} maxlength="24" autocomplete="off" />
          </label>
          <label>{m.dobLabel}
            <input type="date" id={`d${n}`} value={n === 1 ? '1998-04-12' : '2000-08-25'} min="1900-01-01" max="2100-12-31" required />
          </label>
          <div class="m-sign">
            <span class="m-sym" id={`sym${n}`}>{n === 1 ? first.symbol : sixth.symbol}</span>
            <div>
              <div class="m-sname" id={`sn${n}`}>{n === 1 ? first.name : sixth.name}</div>
              <div class="m-sel" id={`se${n}`}></div>
            </div>
          </div>
        </div>
      ))}
    </div>
    <button type="button" class="m-go" id="m-go"><Icon name="sparkles" size={20} />{m.btnCalculate}<Icon name="arrow-right" size={20} /></button>
    <div class="m-stats">
      {stats.map((s) => <div><b class={s.c}>{s.v}</b><span>{s.l}</span></div>)}
    </div>
  </div>

  <div id="m-calc" class="m-calc" hidden aria-live="polite">
    <div class="m-orbit">
      <i class="o1"></i><i class="o2"></i><i class="o3"></i>
      <div class="m-orbit-c"><b id="m-pct">18%</b><span>{m.calcWord}</span></div>
    </div>
    <h3 id="m-status">{m.calc1}</h3>
    <p>{m.calcSub}</p>
    <div class="m-bar"><i id="m-bar-fill" style="width:18%"></i></div>
  </div>

  <div id="m-res" class="m-stack m-res" hidden>
    <div class="m-actions">
      <button type="button" class="m-link" id="m-new"><Icon name="rotate-ccw" size={14} />{m.btnRecalc}</button>
      <button type="button" class="m-ghost m-accent" id="m-story-open"><Icon name="share-2" size={14} />{m.btnStory}</button>
    </div>

    <div class="m-score">
      <div class="m-names" id="r-names"></div>
      <div class="m-big" id="r-score">0%</div>
      <span class="m-badge"><Icon name="stars" size={16} /><span id="r-badge"></span></span>
      <p class="m-overview" id="r-overview"></p>
    </div>

    <div class="m-panel">
      <h3><Icon name="compass" size={16} />{m.aspectsHeading}</h3>
      <div class="m-dims">
        {dims.map((d) => (
          <div class={`m-dim ${d.cls}`}>
            <div><span><Icon name={d.icon} size={14} fill={d.fill} />{d.label}</span><b id={`r-${d.k}-v`}>0%</b></div>
            <div class="m-track"><i id={`r-${d.k}-b`} style="width:0%"></i></div>
          </div>
        ))}
      </div>
    </div>

    <div class="m-ins ins-super"><span><Icon name="zap" size={20} /></span><div><h4>{m.insightSuper}</h4><p id="r-super"></p></div></div>
    <div class="m-ins ins-risk"><span><Icon name="alert-triangle" size={20} /></span><div><h4>{m.insightRisk}</h4><p id="r-risk"></p></div></div>
    <div class="m-ins ins-advice"><span><Icon name="sparkles" size={20} /></span><div><h4>{m.insightAdvice}</h4><p id="r-advice"></p></div></div>

    <a class="m-more" id="r-more" href="#"></a>

    <div class="m-panel m-monet">
      <h3><Icon name="sparkles" size={16} />{m.supportHeading}</h3>
      <div class="m-support">
        <div class="m-sup coffee">
          <div><h4><Icon name="coffee" size={16} />{m.coffeeTitle}</h4><p>{m.coffeeDesc}</p></div>
          <a href={kofi} target="_blank" rel="noopener"><Icon name="coffee" size={14} />{m.coffeeBtn}</a>
        </div>
        <div class="m-sup community">
          <div><h4><Icon name="users" size={16} />{m.communityTitle}</h4><p>{m.communityDesc}</p></div>
          <a href={telegram} target="_blank" rel="noopener"><Icon name="users" size={14} />{m.communityBtn}</a>
        </div>
      </div>
    </div>
  </div>

  <div id="m-modal" class="m-modal" hidden role="dialog" aria-modal="true">
    <div class="m-modal-box">
      <button type="button" class="m-x" id="m-story-close" aria-label="Close"><Icon name="x" size={16} /></button>
      <div class="m-story">
        <div class="m-story-top">
          <span class="m-pill"><Icon name="sparkles" size={12} /><span id="s-title"></span></span>
          <h3 id="s-names"></h3>
          <div class="m-mono" id="s-signs"></div>
        </div>
        <div class="m-story-mid">
          <div class="m-story-score" id="s-score"></div>
          <div class="m-story-badge" id="s-badge"></div>
          <div class="m-story-grid">
            <div>{m.storyLove}: <b id="s-love" class="love"></b></div>
            <div>{m.storyPassion}: <b id="s-passion" class="passion"></b></div>
            <div>{m.storyTrust}: <b id="s-trust" class="trust"></b></div>
            <div>{m.storyMind}: <b id="s-mind" class="mind"></b></div>
          </div>
        </div>
        <div class="m-story-foot">
          <div class="m-mono">{m.storyFooter}</div>
          <b id="s-host"></b>
        </div>
      </div>
      <div class="m-modal-btns">
        <button type="button" class="m-go m-go-sm" id="m-copy"><Icon name="share-2" size={14} /><span>{m.modalCopy}</span></button>
        <button type="button" class="m-ghost" id="m-dl">{m.modalDownload}</button>
        <p>{m.modalHint}</p>
      </div>
    </div>
  </div>

  <script type="application/json" id="match-data" set:html={JSON.stringify(data)} />
</section>

<script>
  import { compatibility } from '../lib/compat';
  import { SIGN_IDS, type SignId } from '../data/core';

  const D = JSON.parse(document.getElementById('match-data')!.textContent!);
  const T = D.ui;
  const $ = <E extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as E;

  function signOf(value: string): SignId | null {
    const mt = /^(\d{4})-(\d{2})-(\d{2})$/.exec(value);
    if (!mt) return null;
    const key = Number(mt[2]) * 100 + Number(mt[3]);
    for (const id of SIGN_IDS) {
      const [s, e] = D.ranges[id];
      const a = s[0] * 100 + s[1], b = e[0] * 100 + e[1];
      if (a <= b ? key >= a && key <= b : key >= a || key <= b) return id;
    }
    return null;
  }

  function preview() {
    for (const n of [1, 2]) {
      const id = signOf($<HTMLInputElement>(`d${n}`).value);
      if (!id) continue;
      const s = D.signs[id];
      $(`sym${n}`).textContent = s.symbol;
      $(`sn${n}`).textContent = s.name;
      $(`se${n}`).textContent = D.elementLabel.replace('{element}', s.elementName);
    }
  }
  $('d1').addEventListener('change', preview);
  $('d2').addEventListener('change', preview);
  preview();

  let last: any = null;
  const show = (id: string) => ['m-input', 'm-calc', 'm-res'].forEach((x) => { $(x).hidden = x !== id; });

  function compute() {
    const a = signOf($<HTMLInputElement>('d1').value), b = signOf($<HTMLInputElement>('d2').value);
    if (!a || !b) return null;
    const c = compatibility(a, b);
    const sa = D.signs[a], sb = D.signs[b];
    const badge = sa.element === sb.element ? T.badgeMirror
      : c.opposite ? T.badgeMagnet
      : c.overall >= 85 ? T.badgeKarmic : D.ratings[c.rating];
    const line = (s: any) => D.challengesLine.replace('{name}', s.name).replace('{list}', s.challenges.join(', '));
    return {
      a, b, c, badge,
      n1: $<HTMLInputElement>('n1').value.trim() || sa.name,
      n2: $<HTMLInputElement>('n2').value.trim() || sb.name,
      mind: c.communication,
      overview: D.elementPairs[c.elementKey],
      superText: D.ui.superText.replace('{a}', sa.name).replace('{sa}', sa.strengths.join(', ')).replace('{b}', sb.name).replace('{sb}', sb.strengths.join(', ')),
      riskText: a === b ? line(sa) : `${line(sa)} ${line(sb)}`,
      adviceText: D.modalityPairs[c.modalityKey],
      url: D.pairUrls[`${a}|${b}`],
    };
  }

  function render(r: any) {
    const sa = D.signs[r.a], sb = D.signs[r.b];
    const nm = $('r-names'); nm.replaceChildren();
    const mk = (cls: string, text: string) => { const e = document.createElement('span'); e.className = cls; e.textContent = text; nm.append(e); };
    mk('nm', r.n1); mk('sy', sa.symbol); mk('pl', '+'); mk('nm', r.n2); mk('sy', sb.symbol);
    $('r-score').textContent = r.c.overall + '%';
    $('r-badge').textContent = r.badge;
    const vals: Record<string, number> = { love: r.c.love, passion: r.c.passion, trust: r.c.trust, mind: r.mind };
    for (const k of Object.keys(vals)) {
      $(`r-${k}-v`).textContent = vals[k] + '%';
      const bar = $(`r-${k}-b`); bar.style.width = '0%';
      requestAnimationFrame(() => requestAnimationFrame(() => { bar.style.width = vals[k] + '%'; }));
    }
    $('r-overview').textContent = r.overview;
    $('r-super').textContent = r.superText;
    $('r-risk').textContent = r.riskText;
    $('r-advice').textContent = r.adviceText;
    const more = $<HTMLAnchorElement>('r-more');
    more.href = r.url;
    more.textContent = T.readMore.replace('{a}', sa.name).replace('{b}', sb.name);

    $('s-title').textContent = T.modalTitle.replace('{site}', D.site);
    $('s-names').textContent = `${r.n1} + ${r.n2}`;
    $('s-signs').textContent = `${sa.name} ${sa.symbol} & ${sb.name} ${sb.symbol}`;
    $('s-score').textContent = r.c.overall + '%';
    $('s-badge').textContent = r.badge;
    $('s-love').textContent = vals.love + '%'; $('s-passion').textContent = vals.passion + '%';
    $('s-trust').textContent = vals.trust + '%'; $('s-mind').textContent = vals.mind + '%';
    $('s-host').textContent = location.host;
  }

  function shareUrl() {
    const u = new URL(location.href);
    u.search = '';
    u.searchParams.set('a', $<HTMLInputElement>('d1').value);
    u.searchParams.set('b', $<HTMLInputElement>('d2').value);
    const n1 = $<HTMLInputElement>('n1').value.trim(), n2 = $<HTMLInputElement>('n2').value.trim();
    if (n1) u.searchParams.set('n1', n1);
    if (n2) u.searchParams.set('n2', n2);
    u.hash = 'match-app';
    return u.toString();
  }

  function start() {
    const r = compute();
    if (!r) return;
    show('m-calc');
    let p = 18;
    const bar = $('m-bar-fill'), pct = $('m-pct'), status = $('m-status');
    bar.style.width = '18%'; pct.textContent = '18%'; status.textContent = T.calc1;
    const timer = setInterval(() => {
      p = Math.min(100, p + 20);
      bar.style.width = p + '%'; pct.textContent = p + '%';
      if (p === 58) status.textContent = T.calc2;
      if (p >= 98) status.textContent = T.calc3;
      if (p >= 100) {
        clearInterval(timer);
        setTimeout(() => { last = r; render(r); show('m-res'); history.replaceState(null, '', shareUrl()); $('m-res').scrollIntoView({ behavior: 'smooth', block: 'start' }); }, 400);
      }
    }, 250);
  }
  $('m-go').addEventListener('click', start);
  $('m-new').addEventListener('click', () => {
    show('m-input'); closeModal(); history.replaceState(null, '', location.pathname);
    $('match-app').scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  const modal = $('m-modal');
  function openModal() {
    if (!modal) return;
    if (modal.parentElement !== document.body) {
      document.body.appendChild(modal);
    }
    modal.hidden = false;
    document.body.style.overflow = 'hidden';
  }
  function closeModal() {
    if (!modal) return;
    modal.hidden = true;
    document.body.style.overflow = '';
  }
  $('m-story-open').addEventListener('click', openModal);
  $('m-story-close').addEventListener('click', closeModal);
  modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });

  $('m-copy').addEventListener('click', async () => {
    const label = $('m-copy').querySelector('span')!;
    const original = label.textContent;
    try { await navigator.clipboard.writeText(shareUrl()); label.textContent = T.modalCopied; } catch { label.textContent = shareUrl(); }
    setTimeout(() => { label.textContent = original; }, 2000);
  });

  // 1080x1920 story image drawn on a canvas, no external libraries.
  $('m-dl').addEventListener('click', () => {
    if (!last) return;
    const W = 1080, H = 1920;
    const cv = document.createElement('canvas'); cv.width = W; cv.height = H;
    const g = cv.getContext('2d')!;
    const bg = g.createLinearGradient(0, 0, 0, H);
    bg.addColorStop(0, '#1c1538'); bg.addColorStop(0.5, '#0f0d22'); bg.addColorStop(1, '#070611');
    g.fillStyle = bg; g.fillRect(0, 0, W, H);
    const glow = g.createRadialGradient(W / 2, 260, 20, W / 2, 260, 700);
    glow.addColorStop(0, 'rgba(192,38,211,0.35)'); glow.addColorStop(1, 'rgba(192,38,211,0)');
    g.fillStyle = glow; g.fillRect(0, 0, W, H);
    g.strokeStyle = 'rgba(217,70,239,0.4)'; g.lineWidth = 6; g.strokeRect(30, 30, W - 60, H - 60);
    const font = 'system-ui, -apple-system, "Segoe UI", Roboto, "Noto Sans", sans-serif';
    g.textAlign = 'center';
    const text = (s: string, y: number, size: number, color: string, weight = '700') => {
      g.font = `${weight} ${size}px ${font}`; g.fillStyle = color; g.fillText(s, W / 2, y);
    };
    const r = last, sa = D.signs[r.a], sb = D.signs[r.b];
    text('✦ ' + T.modalTitle.replace('{site}', D.site).toUpperCase(), 190, 38, '#d8b4fe');
    text(`${r.n1} + ${r.n2}`, 300, 72, '#ffffff');
    text(`${sa.name} ${sa.symbol} & ${sb.name} ${sb.symbol}`, 380, 44, '#94a3b8', '500');
    const sg = g.createLinearGradient(300, 600, 780, 900);
    sg.addColorStop(0, '#f9a8d4'); sg.addColorStop(0.5, '#e9d5ff'); sg.addColorStop(1, '#c7d2fe');
    g.font = `900 320px ${font}`; g.fillStyle = sg; g.fillText(r.c.overall + '%', W / 2, 800);
    text(r.badge, 900, 56, '#e9d5ff', '600');
    const cells: [string, number, string][] = [
      [T.storyLove, r.c.love, '#f9a8d4'], [T.storyPassion, r.c.passion, '#fdba74'],
      [T.storyTrust, r.c.trust, '#6ee7b7'], [T.storyMind, r.mind, '#67e8f9'],
    ];
    cells.forEach(([label, v, color], i) => {
      const x = 130 + (i % 2) * 450, y = 1040 + Math.floor(i / 2) * 150;
      g.fillStyle = 'rgba(255,255,255,0.07)'; g.beginPath(); g.roundRect(x, y, 400, 120, 28); g.fill();
      g.textAlign = 'left'; g.font = `500 40px ${font}`; g.fillStyle = '#cbd5e1'; g.fillText(label + ':', x + 34, y + 76);
      g.textAlign = 'right'; g.font = `800 44px ${font}`; g.fillStyle = color; g.fillText(v + '%', x + 368, y + 76);
      g.textAlign = 'center';
    });
    g.strokeStyle = 'rgba(255,255,255,0.12)'; g.lineWidth = 2;
    g.beginPath(); g.moveTo(130, 1660); g.lineTo(W - 130, 1660); g.stroke();
    text(T.storyFooter, 1730, 36, '#94a3b8', '500');
    text(location.host, 1805, 56, '#f0abfc');
    cv.toBlob((blob) => {
      if (!blob) return;
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob); a.download = 'synastry.png'; a.click();
      setTimeout(() => URL.revokeObjectURL(a.href), 1000);
    }, 'image/png');
  });

  // Shared link: ?a=YYYY-MM-DD&b=YYYY-MM-DD&n1=..&n2=.. restores the result.
  const q = new URLSearchParams(location.search);
  if (q.get('a') && q.get('b')) {
    $<HTMLInputElement>('d1').value = q.get('a')!;
    $<HTMLInputElement>('d2').value = q.get('b')!;
    $<HTMLInputElement>('n1').value = (q.get('n1') || '').slice(0, 24);
    $<HTMLInputElement>('n2').value = (q.get('n2') || '').slice(0, 24);
    preview();
    const r = compute();
    if (r) { last = r; render(r); show('m-res'); }
  }
</script>

<style is:global>
  .m-app { margin: 8px 0 28px; max-width: 768px; margin-inline: auto; }
  .m-hero { text-align: center; margin: 8px 0 20px; }
  .m-hero h1 { 
    font-family: var(--heading-font); 
    font-size: clamp(1.8rem, 5vw, 2.8rem); 
    line-height: 1.15; 
    font-weight: 800; 
    letter-spacing: -0.02em; 
    margin: 10px 0 8px; 
    background: linear-gradient(180deg, #fff, #f1f5f9 40%, #94a3b8); 
    -webkit-background-clip: text; 
    background-clip: text; 
    -webkit-text-fill-color: transparent; 
  }
  [data-theme="millennial"] .m-hero h1, [data-theme="genx"] .m-hero h1, [data-theme="boomer"] .m-hero h1 { background: none; -webkit-text-fill-color: currentColor; }
  .m-hero p { color: var(--muted); max-width: 32rem; margin: 0 auto; font-size: 0.92rem; line-height: 1.5; }
  .m-pill { display: inline-flex; align-items: center; gap: 6px; padding: 4px 12px; border-radius: 999px; border: 1px solid var(--line); background: #ffffff0d; color: #f0abfc; font-size: .78rem; font-weight: 600; }
  .m-pill .icon-fill { color: #f472b6; }
  [data-theme="millennial"] .m-pill, [data-theme="boomer"] .m-pill { color: var(--brand-dark); }
  
  .m-stack { display: grid; gap: 16px; }
  .m-stack[hidden], .m-calc[hidden], .m-modal[hidden] { display: none !important; }
  
  .m-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; position: relative; }
  .m-join { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); width: 36px; height: 36px; border-radius: 50%; display: grid; place-items: center; color: #fff; background: linear-gradient(135deg, #c026d3, #4f46e5); border: 2px solid #05040a; z-index: 2; box-shadow: 0 8px 20px #c026d333; }
  
  .m-card { background: var(--card); border: 1px solid var(--card-border); border-radius: var(--radius); padding: 16px; display: grid; gap: 12px; backdrop-filter: blur(14px); transition: border-color .3s, box-shadow .3s; }
  .m-card:hover { border-color: #c084fc59; box-shadow: 0 10px 30px -10px #a855f733; }
  .m-card label { display: grid; gap: 5px; font-size: .78rem; color: var(--muted); }
  .m-card input { width: 100%; box-sizing: border-box; }
  .m-card input:focus { outline: none; border-color: #c084fc; }
  .m-p2 input:focus { border-color: #e879f9; }
  
  .m-tag { display: flex; align-items: center; gap: 6px; font-family: ui-monospace, Menlo, Consolas, monospace; font-size: .7rem; letter-spacing: .06em; text-transform: uppercase; font-weight: 700; color: #c084fc; }
