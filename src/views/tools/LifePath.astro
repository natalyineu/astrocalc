---
import Base from '../../layouts/Base.astro';
import AdSlot from '../../components/AdSlot.astro';
import Faq from '../../components/Faq.astro';
import { getT } from '../../lib/content';
import { pageUrl } from '../../lib/routes';
const { locale, page } = Astro.props;
const t = getT(locale);
const tool = t.tools['life-path'];
const data = { label: tool.resultLabel, lifePath: t.lifePath };
---
<Base locale={locale} pageId={page.id} title={tool.title} description={tool.description}>
  <p class="crumbs"><a href={pageUrl(locale, 'home')}>{t.ui.home}</a> › {tool.crumb}</p>
  <h1>{tool.h1}</h1>
  <p class="lead">{tool.lead}</p>
  <div class="card">
    <form class="calc" id="f">
      <label>{t.ui.dateOfBirth} <input type="date" id="date" required min="1900-01-01" max="2100-12-31" /></label>
      <button type="submit">{tool.button}</button>
    </form>
    <div class="result" id="result">
      <p class="muted" id="label"></p>
      <div class="big" id="num"></div>
      <h3 id="title"></h3>
      <p id="desc"></p>
    </div>
  </div>
  <AdSlot slot={import.meta.env.PUBLIC_AD_SLOT_CONTENT} />
  <h2>{tool.meaningsHeading}</h2>
  {Object.entries(t.lifePath).map(([n, v]: [string, any]) => (
    <>
      <h3 id={`n${n}`}>{n} – {v.title}</h3>
      <p>{v.text}</p>
    </>
  ))}
  <Faq heading={t.ui.faq} items={tool.faq} />
  <script type="application/json" id="data" set:html={JSON.stringify(data)} />
</Base>

<script>
  import { lifePathNumber } from '../../lib/astro';
  const $ = (id: string) => document.getElementById(id)!;
  const data = JSON.parse($('data').textContent!);
  $('f').addEventListener('submit', (e) => {
    e.preventDefault();
    const [y, m, d] = ($('date') as HTMLInputElement).value.split('-').map(Number);
    const n = lifePathNumber(y, m, d);
    const info = data.lifePath[n];
    $('label').textContent = data.label;
    $('num').textContent = String(n);
    $('title').textContent = info.title;
    $('desc').textContent = info.text;
    $('result').classList.add('show');
  });
</script>
