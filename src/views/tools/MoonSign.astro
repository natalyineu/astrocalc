---
import Base from '../../layouts/Base.astro';
import AdSlot from '../../components/AdSlot.astro';
import Faq from '../../components/Faq.astro';
import { getT, allSigns, fmt, list } from '../../lib/content';
import { pageUrl } from '../../lib/routes';
const { locale, page } = Astro.props;
const t = getT(locale);
const tool = t.tools['moon-sign'];
const signs = allSigns(locale);
const offsets = [-12,-11,-10,-9.5,-9,-8,-7,-6,-5,-4,-3.5,-3,-2,-1,0,1,2,3,3.5,4,4.5,5,5.5,5.75,6,7,8,9,9.5,10,11,12,13];
const label = (o: number) => {
  const abs = Math.abs(o);
  const h = Math.trunc(abs);
  const m = Math.round((abs - h) * 60);
  return `UTC${o >= 0 ? '+' : '−'}${h}${m ? ':' + String(m).padStart(2, '0') : ''}`;
};
const data = {
  strings: { resultLabel: tool.resultLabel, resultText: tool.resultText },
  signs: Object.fromEntries(signs.map((s) => [s.id, {
    name: s.name, symbol: s.symbol, url: s.url, element: s.element, modality: s.modality,
    keywords: list(locale, s.keywords),
  }])),
};
---
<Base locale={locale} pageId={page.id} title={tool.title} description={tool.description}>
  <p class="crumbs"><a href={pageUrl(locale, 'home')}>{t.ui.home}</a> › {tool.crumb}</p>
  <h1>{tool.h1}</h1>
  <p class="lead">{tool.lead}</p>
  <div class="card">
    <form class="calc" id="f">
      <div class="row">
        <label>{t.ui.birthDate} <input type="date" id="date" required min="1900-01-01" max="2100-12-31" /></label>
        <label>{t.ui.birthTime} <input type="time" id="time" value="12:00" required /></label>
      </div>
      <div class="row">
        <label>{t.ui.timezone}
          <select id="offset">{offsets.map((o) => <option value={o} selected={o === 0}>{label(o)}</option>)}</select>
        </label>
      </div>
      <button type="submit">{tool.button}</button>
    </form>
    <div class="result" id="result">
      <p class="muted">{tool.resultLabel}</p>
      <div class="big" id="name"></div>
      <p id="desc"></p>
      <p><a id="more" class="btn" href="#">{t.ui.aboutSign}</a></p>
    </div>
  </div>
  <AdSlot slot={import.meta.env.PUBLIC_AD_SLOT_CONTENT} />
  <h2>{tool.aboutHeading}</h2>
  <p>{tool.aboutText}</p>
  <Faq heading={t.ui.faq} items={tool.faq} />
  <script type="application/json" id="data" set:html={JSON.stringify(data)} />
</Base>

<script>
  import { moonSign, dateFromLocal } from '../../lib/astro';
  const $ = (id: string) => document.getElementById(id)!;
  const data = JSON.parse($('data').textContent!);
  $('f').addEventListener('submit', (e) => {
    e.preventDefault();
    const [y, mo, d] = ($('date') as HTMLInputElement).value.split('-').map(Number);
    const [h, mi] = ($('time') as HTMLInputElement).value.split(':').map(Number);
    const off = Number(($('offset') as HTMLSelectElement).value);
    const { id, degrees } = moonSign(dateFromLocal(y, mo, d, h, mi, off));
    const s = data.signs[id];
    $('name').textContent = `${s.symbol} ${s.name}`;
    $('desc').textContent = (data.strings.resultText as string)
      .replace('{degrees}', String(Math.floor(degrees))).replace('{sign}', s.name)
      .replace('{element}', s.element).replace('{modality}', s.modality).replace('{keywords}', s.keywords);
    ($('more') as HTMLAnchorElement).href = s.url;
    $('result').classList.add('show');
  });
</script>
